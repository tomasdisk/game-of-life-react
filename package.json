{
  "name": "game-of-life-react",
  "description": "Game of life implemented in P5.js wrapped on React.js app",
  "author": "tomasdisk",
  "homepage": "https://tomasdisk.github.io/game-of-life-react",
  "version": "1.0.0",
  "dependencies": {
    "@p5-wrapper/react": "^4.4.2",
    "@tailwindcss/cli": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/p5": "^1.7.7",
    "@types/react": "18",
    "@types/react-dom": "18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-scripts": "5.0.1",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "start": "react-scripts start",
    "start-tailwind": "npx @tailwindcss/cli -i ./src/index.css -o ./public/output.css --watch",
    "build": "npx @tailwindcss/cli -i ./src/index.css -o ./public/output.css && react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
